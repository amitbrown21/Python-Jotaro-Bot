# Discord Bot Configuration
# Local: keep this file as .env next to main.py
# Docker/TrueNAS: mount the folder that contains this file to /config

# Your Discord bot token (required)
# Get it from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Guild IDs for slash command syncing (comma-separated)
GUILD_IDS=123456789012345678,987654321098765432

# Optional: only needed when YouTube answers playback with HTTP 403 Forbidden
# (container log shows "[https] HTTP error 403 Forbidden" / "FFmpeg exited with code 8").
# YTDLP_COOKIES points at a Netscape cookies.txt exported from a logged-in browser and
# is the reliable fix once YouTube blocks this host's IP.
# YTDLP_PLAYER_CLIENT overrides the YouTube client instead, e.g. web_safari,tv
# YTDLP_COOKIES=/config/cookies.txt
# YTDLP_PLAYER_CLIENT=web_safari,tv
